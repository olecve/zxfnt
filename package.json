{
  "name": "zxfnt",
  "version": "0.1.0",
  "private": true,
  "description": "Builds web fonts from 8x8 pixel fonts",
  "license": "MIT AND OFL-1.1",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "knip": "6.44.1",
    "opentype.js": "2.0.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "scripts": {
    "build": "node --experimental-strip-types src/build.ts",
    "compose": "node --experimental-strip-types src/compose-fonts.ts",
    "serve": "node --experimental-strip-types src/serve.ts",
    "check": "tsc -p .",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "validate": "npm run format:check && npm run lint && npm run knip && npm run check && npm test"
  }
}
