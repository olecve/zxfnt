{
  "name": "zxfnt",
  "version": "0.1.0",
  "private": true,
  "description": "Builds web fonts from 8x8 ZX Spectrum fonts",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-slop": "0.1.3",
    "globals": "17.14.0",
    "knip": "6.44.1",
    "opentype.js": "2.0.0",
    "preact": "11.1.1",
    "prettier": "3.10.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "wawoff2": "2.0.1"
  },
  "scripts": {
    "build": "node --experimental-strip-types src/build.ts",
    "import:rom": "node --experimental-strip-types src/import-rom.ts",
    "compose": "node --experimental-strip-types src/compose-fonts.ts",
    "serve": "node --experimental-strip-types src/serve.ts",
    "edit": "node --experimental-strip-types src/edit.ts",
    "check": "tsc -p . && tsc -p src/editor && tsc -p src/demo",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "validate": "npm run format:check && npm run lint && npm run knip && npm run check && npm test"
  }
}
