{
  "name": "zxfnt",
  "version": "0.1.0",
  "private": true,
  "description": "Builds web fonts from 8x8 ZX Spectrum fonts",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "opentype.js": "2.0.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "scripts": {
    "build": "node --experimental-strip-types src/build.ts",
    "import:rom": "node --experimental-strip-types src/import-rom.ts",
    "serve": "node --experimental-strip-types src/serve.ts",
    "check": "tsc -p .",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run lint && npm run check && npm test"
  }
}
